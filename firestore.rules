rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'dj6rUnyrXibiFgJIKurypUJZ6SE2';
    }

    function validPublicOrder() {
      return request.resource.data.keys().hasOnly([
          'cliente', 'telefono', 'producto', 'estado', 'origen', 'folio',
          'categoria', 'total', 'subtotal', 'descuento', 'cupon', 'anticipo', 'fechaEntrega', 'tipoEntrega',
          'notas', 'items', 'archivo', 'cancelacionToken', 'creadoEn'
        ])
        && request.resource.data.cliente is string
        && request.resource.data.cliente.size() >= 2
        && request.resource.data.cliente.size() <= 100
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() >= 7
        && request.resource.data.telefono.size() <= 20
        && request.resource.data.producto is string
        && request.resource.data.producto.size() >= 3
        && request.resource.data.producto.size() <= 3000
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() <= 100
        && request.resource.data.fechaEntrega is string
        && request.resource.data.fechaEntrega.size() <= 10
        && request.resource.data.tipoEntrega in ['Por acordar', 'Recoger', 'Punto medio', 'Envío']
        && request.resource.data.notas is string
        && request.resource.data.notas.size() <= 1500
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50
        && request.resource.data.archivo is string
        && request.resource.data.archivo.size() <= 500000
        && request.resource.data.cancelacionToken is string
        && request.resource.data.cancelacionToken.size() == 64
        && request.resource.data.estado == 'Nuevo'
        && request.resource.data.origen in ['Carrito web', 'Formulario web']
        && request.resource.data.folio is string
        && request.resource.data.folio.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= request.resource.data.total
        && request.resource.data.descuento is number
        && request.resource.data.descuento >= 0
        && request.resource.data.total == request.resource.data.subtotal - request.resource.data.descuento
        && request.resource.data.cupon is string
        && request.resource.data.cupon.size() <= 30
        && (
          (request.resource.data.cupon == '' && request.resource.data.descuento == 0)
          || (
            request.resource.data.cupon != ''
            && get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon)).data.activa == true
            && request.resource.data.subtotal >= get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon)).data.minCompra
            && (
              (get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon)).data.tipo == 'Porcentaje'
                && request.resource.data.descuento <= request.resource.data.subtotal * get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon)).data.valor / 100 + 0.01)
              || (get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon)).data.tipo == 'Monto fijo'
                && request.resource.data.descuento <= get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon)).data.valor)
            )
            && (
              get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon)).data.limiteUsos == 0
              || get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon)).data.usos < get(/databases/$(database)/documents/cupones/$(request.resource.data.cupon)).data.limiteUsos
            )
          )
        )
        && request.resource.data.anticipo == 0
        && request.resource.data.creadoEn == request.time;
    }

    match /encargos/{orderId} {
      allow create: if isAdmin() || validPublicOrder();
      allow read, update, delete: if isAdmin();

      match /pagos/{paymentId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    match /seguimiento/{folio} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['folio','estado','fechaEntrega','total','pagado','saldo','permitirOcultar','actualizadoEn'])
        && request.resource.data.folio == folio
        && folio.size() >= 20
        && request.resource.data.estado == 'Nuevo'
        && request.resource.data.pagado == 0
        && request.resource.data.saldo == request.resource.data.total
        && request.resource.data.permitirOcultar == false
        && request.resource.data.actualizadoEn == request.time
      );
      allow update, delete: if isAdmin();
    }

    match /cupones/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usos','ultimoPedidoId'])
        && request.resource.data.usos == resource.data.usos + 1
        && request.resource.data.ultimoPedidoId is string
        && getAfter(/databases/$(database)/documents/encargos/$(request.resource.data.ultimoPedidoId)).data.cupon == code
        && getAfter(/databases/$(database)/documents/encargos/$(request.resource.data.ultimoPedidoId)).data.creadoEn == request.time
        && (resource.data.limiteUsos == 0 || request.resource.data.usos <= resource.data.limiteUsos)
      );
    }

    match /cancelaciones/{token} {
      allow get: if token.size() == 64;
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        token.size() == 64
        && request.resource.data.keys().hasOnly(['orderId','folio','estado','motivo','creadoEn'])
        && request.resource.data.orderId is string
        && request.resource.data.folio is string
        && request.resource.data.estado == 'Disponible'
        && request.resource.data.motivo == ''
        && request.resource.data.creadoEn == request.time
        && getAfter(/databases/$(database)/documents/encargos/$(request.resource.data.orderId)).data.cancelacionToken == token
        && getAfter(/databases/$(database)/documents/encargos/$(request.resource.data.orderId)).data.folio == request.resource.data.folio
      );
      allow update: if isAdmin() || (
        token.size() == 64
        && resource.data.estado == 'Disponible'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','motivo','solicitadaEn'])
        && request.resource.data.estado == 'Solicitada'
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 3
        && request.resource.data.motivo.size() <= 300
        && request.resource.data.solicitadaEn == request.time
        && get(/databases/$(database)/documents/encargos/$(resource.data.orderId)).data.total > 300
        && !(get(/databases/$(database)/documents/encargos/$(resource.data.orderId)).data.estado in ['Entregado', 'Cancelado'])
      );
      allow delete: if isAdmin();
    }

    match /{collectionName}/{documentId} {
      allow read: if collectionName in [
        'productos', 'categorias', 'novedades', 'promociones', 'galeria', 'configuracion'
      ];
      allow write: if isAdmin();
    }
  }
}
